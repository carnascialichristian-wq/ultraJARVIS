{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrajarvis.local/schemas/backlog.schema.json",
  "title": "ultraJARVIS task backlog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program",
    "generated_at",
    "source_ref",
    "baselines",
    "tasks"
  ],
  "properties": {
    "schema_version": { "const": "ultrajarvis.backlog/v1" },
    "program": { "const": "ultraJARVIS" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_ref": { "type": "string", "minLength": 1 },
    "scope_note": { "type": "string", "minLength": 1 },
    "baselines": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/baseline" }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_id",
        "title",
        "scope_status",
        "declared_weight",
        "task_ids"
      ],
      "properties": {
        "baseline_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "scope_status": {
          "enum": ["DRAFT", "BASELINED", "SUPERSEDED", "CLOSED"]
        },
        "declared_weight": { "type": "integer", "minimum": 0 },
        "task_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/taskId" }
        },
        "notes": { "type": "string" }
      }
    },
    "taskId": {
      "type": "string",
      "pattern": "^UJ-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "title",
        "epic",
        "milestones",
        "owner",
        "reviewer",
        "status",
        "priority",
        "dependencies",
        "inputs",
        "output_contract",
        "acceptance_criteria",
        "proof",
        "data_class",
        "side_effect",
        "approval_gate",
        "weight",
        "completed_weight",
        "remaining_weight",
        "confidence",
        "blocker",
        "next_action",
        "updated_at"
      ],
      "properties": {
        "task_id": { "$ref": "#/$defs/taskId" },
        "title": { "type": "string", "minLength": 3 },
        "epic": { "type": "string", "minLength": 1 },
        "milestones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^M(?:[0-9]|1[0-7])$" }
        },
        "owner": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "PROPOSED",
            "TRIAGED",
            "READY",
            "IN_PROGRESS",
            "REVIEW",
            "DONE",
            "BLOCKED",
            "DEFERRED",
            "CANCELLED",
            "SUPERSEDED"
          ]
        },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/taskId" }
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactRef" }
        },
        "output_contract": { "type": "string", "minLength": 3 },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/criterion" }
        },
        "proof": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactRef" }
        },
        "data_class": { "enum": ["C0", "C1", "C2", "C3", "C4"] },
        "side_effect": {
          "enum": ["NONE", "INTERNAL_WRITE", "EXTERNAL_WRITE", "DESTRUCTIVE"]
        },
        "approval_gate": { "type": "string", "minLength": 1 },
        "weight": { "type": "integer", "minimum": 0 },
        "completed_weight": { "type": "integer", "minimum": 0 },
        "remaining_weight": { "type": "integer", "minimum": 0 },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "reason"],
          "properties": {
            "level": { "enum": ["LOW", "MEDIUM", "HIGH"] },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "blocker": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "cause", "resolver"],
              "properties": {
                "kind": {
                  "enum": [
                    "DEPENDENCY",
                    "AWAITING_HUMAN",
                    "CAPABILITY",
                    "POLICY",
                    "EVIDENCE",
                    "TECHNICAL",
                    "EXTERNAL"
                  ]
                },
                "cause": { "type": "string", "minLength": 1 },
                "resolver": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "next_action": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "text", "state", "proof_refs"],
      "properties": {
        "criterion_id": { "type": "string", "pattern": "^AC-[0-9]{2}$" },
        "text": { "type": "string", "minLength": 3 },
        "state": { "enum": ["PENDING", "PASSED", "FAILED", "NOT_APPLICABLE"] },
        "proof_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "hash": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
