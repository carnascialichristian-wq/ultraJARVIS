{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultrajarvis.local/schemas/delegation-card.schema.json",
  "title": "ultraJARVIS DelegationCard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_id",
    "created_at",
    "created_by",
    "target_ai",
    "target_product",
    "mission_id",
    "task_id",
    "task_snapshot",
    "role",
    "repository_scope",
    "context_digest",
    "input_artifacts",
    "instructions",
    "required_output_schema",
    "acceptance_criteria",
    "forbidden_actions",
    "data_class",
    "allowed_modes",
    "side_effect_limit",
    "autonomy_ceiling",
    "tool_allowlist",
    "call_budget",
    "reviewer",
    "expires_at",
    "return_channel",
    "idempotency_key",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "ultrajarvis.delegation-card/v1" },
    "card_id": { "type": "string", "pattern": "^UJ-CARD-[A-Z0-9-]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "$ref": "#/$defs/party" },
    "target_ai": { "enum": ["CHATGPT", "CLAUDE", "GEMINI", "GROK", "AUXILIARY_AI"] },
    "target_product": { "type": "string", "minLength": 1 },
    "mission_id": { "type": "string", "pattern": "^UJ-MISSION-[A-Z0-9-]+$" },
    "task_id": { "$ref": "#/$defs/taskId" },
    "task_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "weight", "accepted_weight", "priority"],
      "properties": {
        "status": { "const": "READY" },
        "weight": { "type": "integer", "minimum": 1 },
        "accepted_weight": { "const": 0 },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] }
      }
    },
    "role": { "type": "string", "minLength": 3 },
    "repository_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "read_ref", "write_branch_patterns", "direct_main_write"],
      "properties": {
        "full_name": { "const": "carnascialichristian-wq/ultraJARVIS" },
        "read_ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "write_branch_patterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "direct_main_write": { "const": false }
      }
    },
    "context_digest": { "type": "string", "minLength": 20 },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "instructions": { "type": "string", "minLength": 50 },
    "required_output_schema": { "const": "ultrajarvis.response-packet/v1" },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "data_class": { "$ref": "#/$defs/dataClass" },
    "allowed_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/providerMode" }
    },
    "side_effect_limit": { "$ref": "#/$defs/sideEffect" },
    "autonomy_ceiling": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
    "tool_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "call_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_model_calls", "max_tool_calls", "incremental_cost_eur"],
      "properties": {
        "max_model_calls": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 0 },
        "incremental_cost_eur": { "const": 0 }
      }
    },
    "reviewer": { "enum": ["CHATGPT", "CLAUDE", "GEMINI", "GROK", "CHRISTIAN"] },
    "expires_at": { "type": "string", "format": "date-time" },
    "return_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "destination", "requires_artifact_hashes"],
      "properties": {
        "mode": { "enum": ["dashboard-import", "github-pr", "copy-paste"] },
        "destination": { "type": "string", "minLength": 1 },
        "requires_artifact_hashes": { "const": true }
      }
    },
    "idempotency_key": { "type": "string", "pattern": "^UJ-IDEMP-[A-Z0-9-]+$" },
    "status": { "enum": ["READY", "REVOKED", "EXPIRED", "CONSUMED"] }
  },
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^UJ-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_id", "product"],
      "properties": {
        "ai_id": { "enum": ["CHATGPT", "CLAUDE", "GEMINI", "GROK", "AUXILIARY_AI", "CHRISTIAN"] },
        "product": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256", "media_type", "data_class"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "media_type": { "type": "string", "minLength": 1 },
        "data_class": { "$ref": "#/$defs/dataClass" }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "text", "verification"],
      "properties": {
        "criterion_id": { "type": "string", "pattern": "^AC-[0-9]{2}$" },
        "text": { "type": "string", "minLength": 3 },
        "verification": { "type": "string", "minLength": 3 }
      }
    },
    "dataClass": { "enum": ["C0", "C1", "C2", "C3", "C4"] },
    "providerMode": {
      "enum": ["AUTO_VERIFIED", "HUMAN_BRIDGE", "MANUAL_TOOL", "EXPERIMENTAL_SANDBOX"]
    },
    "sideEffect": {
      "enum": ["NONE", "INTERNAL_WRITE", "EXTERNAL_WRITE", "DESTRUCTIVE"]
    }
  }
}
