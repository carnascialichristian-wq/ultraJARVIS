#!/usr/bin/env python3
"""Minimal UltraJarvis CLI (uj).

Commands:
  uj health          – run health scan
  uj status          – show queue status
  uj seed "prompt"   – enqueue a task
  uj run             – process one job from the queue
  uj run --all       – drain the queue (up to 20 jobs)
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))


def cmd_health(_: argparse.Namespace) -> int:
    from core.health import run_health_scan, format_health_report

    report = run_health_scan()
    print(format_health_report(report))
    return 0 if report["overall"] == "PASS" else 1


def cmd_status(_: argparse.Namespace) -> int:
    from core.job_worker import queue_status

    s = queue_status()
    print(f"Queue pending : {s['pending']}")
    print(f"Done jobs     : {s['done']}")
    print(f"Queue file    : {s['queue']}")
    print(f"Done file     : {s['done_file']}")
    return 0


def cmd_seed(args: argparse.Namespace) -> int:
    from core.job_worker import enqueue

    if not args.prompt:
        print("Usage: uj seed \"your task description\"")
        return 2
    rec = enqueue(args.prompt)
    print(f"Enqueued: {rec['prompt'][:80]}…")
    return 0


def cmd_run(args: argparse.Namespace) -> int:
    from core.job_worker import process_one, queue_status

    limit = 20 if args.all else 1
    processed = 0
    for _ in range(limit):
        result = process_one()
        if result is None:
            break
        processed += 1
        status = "OK" if result.get("ok") else "FAIL"
        title = result.get("result", {}).get("title") or result.get("job", {}).get("prompt", "?")[:60]
        print(f"  [{status}] {title}")
    if processed == 0:
        print("Queue empty.")
    else:
        print(f"Processed {processed} job(s). Remaining: {queue_status()['pending']}")
    return 0


def cmd_tools(args: argparse.Namespace) -> int:
    from core.registry import get_registry

    reg = get_registry()
    tools = reg.list_tools(tag=args.tag)
    if not tools:
        print("No tools found.")
        return 0
    for t in tools:
        tags = ",".join(t.tags) if t.tags else "-"
        safe = "safe" if t.safe else "unsafe"
        print(f"  {t.name:24} [{safe}] ({tags})")
        print(f"    {t.description}")
    print(f"\n{len(tools)} tool(s)")
    return 0


def cmd_memory(args: argparse.Namespace) -> int:
    from core.memory import remember, recall

    if args.action == "add":
        if not args.text:
            print("Usage: uj memory add \"fact text\"")
            return 2
        remember(args.text, tags=(args.tag.split(",") if args.tag else None))
        print("Remembered.")
        return 0
    # list / search
    facts = recall(args.text or "", tag=args.tag)
    if not facts:
        print("(empty)")
        return 0
    for f in facts:
        tags = ",".join(f.get("tags") or []) or "-"
        print(f"  [{tags}] {f.get('fact')}")
    print(f"{len(facts)} fact(s)")
    return 0


def cmd_snapshot(_: argparse.Namespace) -> int:
    from core.health import run_health_scan, format_health_report
    from core.metrics import recent, snapshot_counts
    from core.memory import recall
    from core.job_worker import queue_status
    from core.registry import get_registry

    print("=== Health ===")
    print(format_health_report(run_health_scan()))
    print("\n=== Queue ===")
    s = queue_status()
    print(f"pending={s['pending']} done={s['done']}")
    print("\n=== Metrics (counts) ===")
    for k, v in sorted(snapshot_counts().items()):
        print(f"  {k}: {v}")
    print("\n=== Memory (recent) ===")
    for f in recall(limit=5):
        print(f"  - {f.get('fact')}")
    print("\n=== Tools ===")
    print(f"  {len(get_registry().list_tools())} registered")
    return 0


def cmd_skills(args: argparse.Namespace) -> int:
    from core.skills import list_skills, add_skill

    if args.action == "add":
        if not args.name or not args.description:
            print("Usage: uj skills add NAME DESCRIPTION")
            return 2
        add_skill(args.name, args.description)
        print(f"Added skill: {args.name}")
        return 0
    for s in list_skills():
        tags = ",".join(s.get("tags") or []) or "-"
        print(f"  {s.get('name')} [{tags}] – {s.get('description','')[:60]}")
    return 0


def cmd_promote(args: argparse.Namespace) -> int:
    """Promote a successful job's tool.py into tools/ via controlled write."""
    from core.natural_tasks import promote_job_to_tools

    job = args.job_dir
    name = args.name
    if not job or not name:
        print("Usage: uj promote JOB_DIR MODULE_NAME")
        print("  Example: uj promote workspace/jobs/job_xxx gcd")
        return 2
    try:
        dest = promote_job_to_tools(job, name, force=args.force)
        print(f"Promoted → {dest}")
        print("(Not auto-registered; add a ToolSpec in core/registry.py if desired.)")
        return 0
    except Exception as exc:
        print(f"Promote failed: {exc}")
        return 1


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="uj", description="UltraJarvis minimal CLI")
    sub = parser.add_subparsers(dest="command", required=True)

    p_health = sub.add_parser("health", help="Run health scan")
    p_health.set_defaults(func=cmd_health)

    p_status = sub.add_parser("status", help="Show queue status")
    p_status.set_defaults(func=cmd_status)

    p_seed = sub.add_parser("seed", help="Enqueue a natural-language task")
    p_seed.add_argument("prompt", nargs="?", default="")
    p_seed.set_defaults(func=cmd_seed)

    p_run = sub.add_parser("run", help="Process jobs from the queue")
    p_run.add_argument("--all", action="store_true", help="Drain up to 20 jobs")
    p_run.set_defaults(func=cmd_run)

    p_tools = sub.add_parser("tools", help="List registered tools")
    p_tools.add_argument("--tag", default=None, help="Filter by tag (e.g. io, search)")
    p_tools.set_defaults(func=cmd_tools)

    p_mem = sub.add_parser("memory", help="Persistent memory (add / list)")
    p_mem.add_argument("action", choices=["add", "list"], nargs="?", default="list")
    p_mem.add_argument("text", nargs="?", default="")
    p_mem.add_argument("--tag", default=None)
    p_mem.set_defaults(func=cmd_memory)

    p_snap = sub.add_parser("snapshot", help="Health + queue + metrics + memory summary")
    p_snap.set_defaults(func=cmd_snapshot)

    p_sk = sub.add_parser("skills", help="List or add skills")
    p_sk.add_argument("action", choices=["list", "add"], nargs="?", default="list")
    p_sk.add_argument("name", nargs="?", default="")
    p_sk.add_argument("description", nargs="?", default="")
    p_sk.set_defaults(func=cmd_skills)

    p_prom = sub.add_parser("promote", help="Promote a job tool.py into tools/ (controlled write)")
    p_prom.add_argument("job_dir", nargs="?", default="", help="Path to job directory")
    p_prom.add_argument("name", nargs="?", default="", help="Module name (e.g. gcd → gcd_helpers.py)")
    p_prom.add_argument("--force", action="store_true", help="Overwrite even if path looks protected")
    p_prom.set_defaults(func=cmd_promote)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
